// ============================================
// NEXUS HR AI - Prisma Schema
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// MULTI-EMPRESA
// ============================================

model Company {
  id            String   @id @default(uuid())
  name          String
  slug          String   @unique
  cnpj          String?  @unique
  logo          String?
  plan          Plan     @default(STARTER)
  maxUsers      Int      @default(5)
  maxEmployees  Int      @default(50)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users         User[]
  employees     Employee[]
  departments   Department[]
  positions     Position[]
  documents     Document[]
  surveys       Survey[]
  jobPositions  JobPosition[]
  candidates    Candidate[]
  subscriptions Subscription[]
  aiConversations AIConversation[]
  reports       Report[]

  @@map("companies")
}

enum Plan {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

// ============================================
// USUÁRIOS E AUTENTICAÇÃO
// ============================================

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password      String
  name          String
  role          UserRole @default(EMPLOYEE)
  avatar        String?
  isActive      Boolean  @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  employee      Employee?
  aiConversations AIConversation[]
  reports       Report[]
  uploadedDocuments Document[]

  @@index([companyId, email])
  @@map("users")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  HR
  MANAGER
  EMPLOYEE
}

// ============================================
// COLABORADORES
// ============================================

model Employee {
  id            String   @id @default(uuid())
  name          String
  email         String
  phone         String?
  cpf           String?
  birthDate     DateTime?
  hireDate      DateTime
  terminationDate DateTime?
  status        EmployeeStatus @default(ACTIVE)
  photo         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  userId        String?  @unique
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  departmentId  String
  department    Department @relation(fields: [departmentId], references: [id])

  positionId    String
  position      Position @relation(fields: [positionId], references: [id])

  managerId     String?
  manager       Employee? @relation("EmployeeHierarchy", fields: [managerId], references: [id])
  directReports Employee[] @relation("EmployeeHierarchy")

  employeeSkills EmployeeSkill[]
  performanceReviews PerformanceReview[] @relation("Reviewee")
  reviewerPerformanceReviews PerformanceReview[] @relation("Reviewer")
  trainings      Training[]
  aiProfiles     EmployeeIntelligenceProfile[]

  @@index([companyId, departmentId])
  @@index([companyId, status])
  @@map("employees")
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  TERMINATED
}

// ============================================
// DEPARTAMENTOS E CARGOS
// ============================================

model Department {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companyId   String
  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  employees   Employee[]
  positions   Position[]

  @@unique([companyId, name])
  @@map("departments")
}

model Position {
  id          String   @id @default(uuid())
  name        String
  description String?
  level       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companyId   String
  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  employees   Employee[]

  @@unique([companyId, name])
  @@map("positions")
}

// ============================================
// COMPETÊNCIAS
// ============================================

model Skill {
  id          String   @id @default(uuid())
  name        String
  category    String?
  description String?
  createdAt   DateTime @default(now())

  employeeSkills EmployeeSkill[]

  @@unique([name])
  @@map("skills")
}

model EmployeeSkill {
  id          String   @id @default(uuid())
  level       SkillLevel @default(INTERMEDIATE)
  yearsExp    Int?
  lastAssessed DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  skillId     String
  skill       Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([employeeId, skillId])
  @@map("employee_skills")
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

// ============================================
// PERFORMANCE
// ============================================

model PerformanceReview {
  id          String   @id @default(uuid())
  period      String
  score       Float?
  comments    String?
  status      ReviewStatus @default(PENDING)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employeeId  String
  employee    Employee @relation("Reviewee", fields: [employeeId], references: [id], onDelete: Cascade)

  reviewerId  String
  reviewer    Employee @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: Cascade)

  @@index([employeeId, period])
  @@map("performance_reviews")
}

enum ReviewStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

// ============================================
// TREINAMENTOS
// ============================================

model Training {
  id          String   @id @default(uuid())
  name        String
  description String?
  provider    String?
  duration    Int?
  startDate   DateTime?
  endDate     DateTime?
  status      TrainingStatus @default(PLANNED)
  certificate String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("trainings")
}

enum TrainingStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ============================================
// DOCUMENTOS
// ============================================

model Document {
  id          String   @id @default(uuid())
  title       String
  description String?
  fileUrl     String
  fileType    String
  fileSize    Int?
  category    String?
  tags        String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companyId   String
  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  @@map("documents")
}

// ============================================
// CLIMA ORGANIZACIONAL
// ============================================

model Survey {
  id          String   @id @default(uuid())
  title       String
  description String?
  questions   Json
  isActive    Boolean  @default(true)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companyId   String
  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  responses   SurveyResponse[]

  @@map("surveys")
}

model SurveyResponse {
  id          String   @id @default(uuid())
  answers     Json
  submittedAt DateTime @default(now())

  surveyId    String
  survey      Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  employeeId  String

  @@unique([surveyId, employeeId])
  @@map("survey_responses")
}

// ============================================
// GESTÃO DE TALENTOS
// ============================================

model JobPosition {
  id          String   @id @default(uuid())
  title       String
  description String?
  requirements String?
  salary      Float?
  location    String?
  type        JobType @default(FULL_TIME)
  status      JobStatus @default(OPEN)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companyId   String?
  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  candidates  Candidate[]

  @@map("job_positions")
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum JobStatus {
  OPEN
  CLOSED
  ON_HOLD
}

model Candidate {
  id              String   @id @default(uuid())
  name            String
  email           String
  phone           String?
  cpf             String?
  birthDate       DateTime?
  linkedin        String?
  portfolio       String?
  address         String?
  city            String?
  state           String?
  resumeUrl       String?
  coverLetter     String?
  experienceYears Int?
  educationLevel  String?
  expectedSalary  Float?
  availability    String?
  source          String?
  status          CandidateStatus @default(APPLIED)
  notes           String?
  rating          Int?
  tags            String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  jobPositionId   String
  jobPosition     JobPosition @relation(fields: [jobPositionId], references: [id], onDelete: Cascade)

  skills          CandidateSkill[]
  interviews      CandidateInterview[]

  @@index([companyId, status])
  @@index([jobPositionId, status])
  @@map("candidates")
}

model CandidateSkill {
  id          String   @id @default(uuid())
  level       Int      @default(3)
  createdAt   DateTime @default(now())

  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  skillId     String
  skill       Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([candidateId, skillId])
  @@map("candidate_skills")
}

model CandidateInterview {
  id          String   @id @default(uuid())
  title       String
  scheduledAt DateTime
  duration    Int      @default(60)
  type        InterviewType @default(VIDEO)
  status      InterviewStatus @default(SCHEDULED)
  feedback    String?
  score       Int?
  interviewer String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@map("candidate_interviews")
}

enum InterviewType {
  VIDEO
  PHONE
  IN_PERSON
  TECHNICAL
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum CandidateStatus {
  APPLIED
  SCREENING
  INTERVIEW
  TECHNICAL_TEST
  PROPOSAL
  OFFER
  HIRED
  REJECTED
  WITHDRAWN
}

// ============================================
// BASE DE CONHECIMENTO (RAG)
// ============================================

model KnowledgeBaseArticle {
  id          String   @id @default(uuid())
  title       String
  content     String
  category    String?
  tags        String[]
  isPublished Boolean  @default(true)
  views       Int      @default(0)
  authorId    String?
  embedding   Unsupported("vector(1536)")?
  fileUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companyId   String?

  @@index([companyId])
  @@map("knowledge_base_articles")
}

model ContentBriefing {
  id             String   @id @default(uuid())
  topic          String
  market         String
  period         String
  audience       String
  tone           String
  objective      String
  trendScore     Int
  trendSignal    String
  trendSource    String?
  trendMatches   Json
  risingQueries  String[]
  keywords       String[]
  articleIdeas   Json
  outline        Json
  faqs           Json
  rationale      String
  metaDescription String
  cta            String
  generatedAt    DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([market, createdAt])
  @@map("content_briefings")
}

model ContentArticle {
  id              String   @id @default(uuid())
  briefingId      String?
  title           String
  slug            String
  status          String   @default("DRAFT")
  content         String
  seoTitle        String
  metaDescription String
  keywords        String[]
  outline         Json
  cta             String?
  publishedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, createdAt])
  @@index([briefingId])
  @@map("content_articles")
}

// ============================================
// IA - CONVERSAS E AGENTES
// ============================================

model AIConversation {
  id          String   @id @default(uuid())
  title       String?
  messages    Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companyId   String
  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  agentType   AIAgentType?

  @@index([companyId, userId])
  @@map("ai_conversations")
}

enum AIAgentType {
  RECRUITER
  TALENT
  LEARNING
  LEADERSHIP
  GENERAL
}

model AIAgent {
  id          String   @id @default(uuid())
  name        String
  type        AIAgentType @unique
  description String
  systemPrompt String
  isActive    Boolean  @default(true)
  config      Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("ai_agents")
}

// ============================================
// RELATÓRIOS
// ============================================

model Report {
  id          String   @id @default(uuid())
  title       String
  type        ReportType
  content     Json
  fileUrl     String?
  status      ReportStatus @default(GENERATING)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companyId   String
  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  generatedById String
  generatedBy   User @relation(fields: [generatedById], references: [id])

  @@map("reports")
}

enum ReportType {
  EXECUTIVE
  TALENT
  CLIMATE
  PERFORMANCE
  TURNOVER
  CUSTOM
}

enum ReportStatus {
  GENERATING
  COMPLETED
  FAILED
}

// ============================================
// ASSINATURAS SaaS
// ============================================

model Subscription {
  id          String   @id @default(uuid())
  plan        Plan
  status      SubscriptionStatus @default(ACTIVE)
  startDate   DateTime @default(now())
  endDate     DateTime?
  amount      Float
  currency    String   @default("BRL")
  paymentId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companyId   String
  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  PAST_DUE
  TRIAL
}

// ============================================
// EMPLOYEE INTELLIGENCE PROFILE (IA)
// ============================================

model EmployeeIntelligenceProfile {
  id          String   @id @default(uuid())
  professionalSummary String
  competencyMap Json
  strengths    String[]
  improvementAreas String[]
  leadershipPotential Int
  developmentPlan Json
  riskScore    Int
  retentionRisk String
  generatedAt  DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId])
  @@map("employee_intelligence_profiles")
}

// ============================================
// PERFORMANCE REVIEW - Evolução
// ============================================

model PerformanceEvolution {
  id          String   @id @default(uuid())
  period      String
  score       Float
  goals       Json?
  achievements Json?
  createdAt   DateTime @default(now())

  employeeId  String

  @@index([employeeId, period])
  @@map("performance_evolution")
}

// ============================================
// ENGAGEMENT (Pesquisas)
// ============================================

model EngagementSurvey {
  id          String   @id @default(uuid())
  title       String
  questions   Json
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  companyId   String

  responses   EngagementResponse[]

  @@map("engagement_surveys")
}

model EngagementResponse {
  id          String   @id @default(uuid())
  answers     Json
  score       Float?
  submittedAt DateTime @default(now())

  surveyId    String
  survey      EngagementSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  employeeId  String

  @@unique([surveyId, employeeId])
  @@map("engagement_responses")
}
