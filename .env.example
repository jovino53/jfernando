# ============================================
# NEXUS HR AI - Variáveis de Ambiente
# ============================================

# Ambiente
NODE_ENV=development

# Backend
PORT=3000

# Banco de Dados PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=nexus_hr
DB_PASSWORD=nexus_hr_secure_2024
DB_DATABASE=nexus_hr_ai
DATABASE_URL=postgresql://nexus_hr:nexus_hr_secure_2024@localhost:5432/nexus_hr_ai

# Redis
REDIS_URL=redis://localhost:6379

# Autenticação JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=24h

# OAuth (opcional)
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_CALLBACK_URL=http://localhost:3000/auth/callback

# OpenAI API (para IA)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4

# Pinecone (para Vector Database / RAG)
PINECONE_API_KEY=
PINECONE_INDEX=nexus-hr
PINECONE_ENVIRONMENT=us-east1-gcp

# AWS (para Storage de arquivos)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=nexus-hr-documents

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_APP_NAME=Nexus HR AI
NEXT_PUBLIC_APP_URL=http://localhost:3001

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@nexushr.com
PGADMIN_DEFAULT_PASSWORD=admin123

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logs
LOG_LEVEL=debug

# LGPD
DATA_ENCRYPTION_KEY=your-encryption-key-change-in-production
